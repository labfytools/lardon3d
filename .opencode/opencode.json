{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lardon-orchestrator",
  "model": "opencode/mimo-v2.5-free",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md",
    ".opencode/context.md",
    "docs/architecture/overview.md"
  ],
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "external_directory": "deny",
    "edit": {
      "*": "allow",
      "scan3d/**": "deny",
      "scan3d/tri_photos.py": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git add -A*": "deny",
      "git clean*": "deny",
      "git reset*": "deny",
      "rm *": "deny",
      "sudo *": "deny"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "build*/**",
      ".opencode/work/**",
      "scan3d/**"
    ]
  }
}
